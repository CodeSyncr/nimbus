{
  "name": "@codesyncr/hive",
  "version": "1.0.0",
  "description": "Type-safe HTTP client for Nimbus Go applications",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["nimbus", "http-client", "type-safe", "go", "api", "rpc"],
  "author": "CodeSyncr",
  "license": "MIT",
  "homepage": "https://github.com/CodeSyncr/nimbus/tree/main/packages/hive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeSyncr/nimbus.git",
    "directory": "packages/hive"
  },
  "bugs": {
    "url": "https://github.com/CodeSyncr/nimbus/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {},
  "dependencies": {}
}
