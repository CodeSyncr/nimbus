{
  "name": "@codesyncr/echo",
  "version": "1.0.0",
  "description": "Real-time client SDK for Nimbus Transmit (SSE channels)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["nimbus", "sse", "realtime", "websocket", "transmit", "echo"],
  "author": "CodeSyncr",
  "license": "MIT",
  "homepage": "https://github.com/CodeSyncr/nimbus/tree/main/packages/echo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeSyncr/nimbus.git",
    "directory": "packages/echo"
  },
  "bugs": {
    "url": "https://github.com/CodeSyncr/nimbus/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
