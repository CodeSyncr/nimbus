# ── macOS ──────────────────────────────────────────────────
.DS_Store
._*

# ── Go build & test artifacts ──────────────────────────────
# Compiled test binaries from `go test -c` (e.g. livewire.test)
*.test
# Compiled binaries
*.exe
*.dll
*.so
*.dylib
# Locally built plugin command binaries (never publish these into the module —
# a released tag is immutable, and a host-specific binary is dead weight in it)
plugins/*/cmd/*/[a-z]*
!plugins/*/cmd/*/*.go
!plugins/*/cmd/*/*.md
# Coverage & profiling output
*.out
*.prof
coverage.*
# Go workspace files (machine-local)
go.work
go.work.sum

# ── Node (Hive TypeScript client) ──────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.npm/
*.tgz

# ── Tooling / analysis output ──────────────────────────────
graphify-out/

# ── Local env & secrets ────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Generated Hive client (produced per-app by gen:client) ─
.nimbus-client/

# ── Editor / IDE ───────────────────────────────────────────
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# ── Runtime / local data ───────────────────────────────────
tmp/
*.log
*.sqlite
*.sqlite3
*.db
