  "Define bouncer ability": {
    "prefix": "bo:ability",
    "body": [
      "auth.DefineAbility(\"${1:ability-name}\", func(ctx context.Context, user auth.User, resource any) bool {",
      "\t${2:post} := resource.(*models.${3:Post})",
      "\treturn ${4:user.GetID() == fmt.Sprintf(\"%d\", post.UserID)}",
