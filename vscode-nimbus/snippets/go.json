      "\t${2:post} := resource.(*models.${1:Post})",
      "\tswitch action {",
      "\tcase \"${3:view}\":",
      "\t\treturn ${4:true}",
      "\tcase \"${5:update}\":",
      "\t\treturn ${6:user.GetID() == fmt.Sprintf(\"%d\", post.UserID)}",
      "\t}",
      "\treturn false",
      "}"
    ],
    "description": "Define bouncer policy class"
  },
