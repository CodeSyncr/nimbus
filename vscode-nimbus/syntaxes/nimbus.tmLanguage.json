{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nimbus",
  "scopeName": "source.nimbus",
  "patterns": [
    {
      "comment": "Nimbus comment",
      "begin": "\\{\\{--",
      "end": "--\\}\\}",
      "name": "comment.block.nimbus"
    },
    {
      "comment": "Layout directive",
      "match": "@layout\\s*\\(\\s*['\"]([^'\"]*)['\"]\\s*\\)",
      "captures": {
        "0": { "name": "keyword.control.directive.nimbus" },
        "1": { "name": "string.quoted.single.nimbus" }
      }
    },
    {
      "comment": "Include directive",
      "match": "@include\\s*\\(\\s*['\"]([^'\"]*)['\"]\\s*\\)",
      "captures": {
        "0": { "name": "keyword.control.directive.nimbus" },
        "1": { "name": "string.quoted.single.nimbus" }
      }
    },
    {
      "comment": "Conditional: @if(condition)",
      "match": "@if\\s*\\([^)]*\\)",
      "name": "keyword.control.conditional.nimbus"
    },
    {
      "comment": "Conditional: @else if(condition)",
      "match": "@else\\s+if\\s*\\([^)]*\\)",
      "name": "keyword.control.conditional.nimbus"
    },
    {
      "comment": "Conditional: @else",
      "match": "@else\\b",
      "name": "keyword.control.conditional.nimbus"
    },
    {
      "comment": "Loop: @each(item in list)",
      "match": "@each\\s*\\([^)]*\\)",
      "name": "keyword.control.loop.nimbus"
    },
    {
      "comment": "Self-closing component call",
      "match": "@!\\w+(?:\\.\\w+)*\\s*(?:\\([^)]*\\))?",
      "name": "entity.name.tag.component.nimbus"
    },
    {
      "comment": "Component block opening call",
      "match": "@\\w+(?:\\.\\w+)*\\s*(?:\\([^)]*\\))?",
      "name": "entity.name.tag.component.nimbus"
    },
    {
      "comment": "Closing tags or directive end",
      "match": "@(end|endif|endeach)\\b",
      "name": "keyword.control.directive.nimbus"
    },
    {
      "comment": "Raw Output: {{{ expression }}}",
      "begin": "\\{\\{\\{",
      "end": "\\}\\}\\}",
      "name": "meta.embedded.expression.raw.nimbus",
      "patterns": [
        { "include": "#expression-internals" }
      ]
    },
    {
      "comment": "Escaped Output: {{ expression }}",
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "name": "meta.embedded.expression.nimbus",
      "patterns": [
        { "include": "#expression-internals" }
      ]
    },
    {
      "comment": "Embed HTML for the rest of the file",
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "expression-internals": {
      "patterns": [
        {
          "match": "\\b(const|let|var|if|else|return)\\b",
          "name": "keyword.control.nimbus"
        },
        {
          "match": "\\b(true|false|nil|null)\\b",
          "name": "constant.language.nimbus"
        },
        {
          "match": "\\.[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "variable.other.member.nimbus"
        },
        {
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "variable.other.special.nimbus"
        },
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.nimbus"
        },
        {
          "match": "['\"][^'\"]*['\"]",
          "name": "string.quoted.nimbus"
        }
      ]
    }
  }
}
