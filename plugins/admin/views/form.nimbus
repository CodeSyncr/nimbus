@layout('admin/layout')
<div class="max-w-2xl">
  <a href="{{ .prefix }}/{{ .slug }}" class="text-sm text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 mb-4 inline-block">← Back to {{ .slug }}</a>

  <form method="POST" action="{{ .action }}" class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 space-y-5">
    {{ .csrfField }}
    @each(.fields)
    <div>
      <label class="block text-sm font-medium text-slate-600 dark:text-slate-300 mb-1.5">{{ index . "label" }}</label>
      {{ raw (index . "html") }}
    </div>
    @endeach

    <div class="flex items-center gap-3 pt-2">
      <button type="submit" class="px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition">
        @if(.isEdit)Save changes@else Create {{ .singular }}@endif
      </button>
      <a href="{{ .prefix }}/{{ .slug }}" class="px-5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 font-medium hover:bg-slate-50 dark:hover:bg-slate-700 transition">Cancel</a>
    </div>
  </form>
</div>
